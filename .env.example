# Copy to .env (git-ignored). Never commit real values.
# Everything below is optional: the sample demo works with zero keys.

# Register this app and the exact redirect URI in the Twitch developer console.
# Credentials stay on this server; leave them empty for offline sample mode.
COMICTOONS_TWITCH_CLIENT_ID=
COMICTOONS_TWITCH_CLIENT_SECRET=
COMICTOONS_TWITCH_REDIRECT_URI=http://localhost:3001/auth/twitch/callback
# Optional public chat channel; defaults to the signed-in login.
TWITCH_CHANNEL=
# Generated panel art (network images) across ALL keys below, per rolling hour, and the panel budget
# for !ink and chat votes. Default 12; a blank value also reads as 12.
IMAGE_BUDGET_PER_HOUR=12
# Set to 1 only for a short, named proof run; leave unset/0 for builds, gates and QA.
COMICTOONS_ART_NETWORK=
# Art chain keys. Slot 1 is tried first; _2 and _3 are optional spares used when a key
# hits a quota/rate limit (429, 402, a quota code or a specific quota message). A spent key rests until the next
# UTC day. Leave unused slots empty. Account ids are optional (looked up from the token).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN_2=
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_API_TOKEN_3=
CLOUDFLARE_ACCOUNT_ID_3=
POLLINATIONS_API_KEY=
POLLINATIONS_API_KEY_2=
POLLINATIONS_API_KEY_3=

# Unset means studio writes are local-only; remote clients send the configured key
# in the x-comictoons-director-key header.
COMICTOONS_DIRECTOR_KEY=

# Explicitly opt in to a LAN-visible dev server; configure a director key before exposing.
COMICTOONS_WEB_EXPOSE=

# Optional loopback fake endpoints; leave empty for unchanged production defaults.
COMICTOONS_TWITCH_AUTH_BASE_URL=
COMICTOONS_TWITCH_HELIX_BASE_URL=
COMICTOONS_TWITCH_EVENTSUB_WS_URL=
COMICTOONS_TWITCH_IRC_URL=
# Set to 1 only to explicitly permit non-loopback endpoint overrides.
COMICTOONS_TWITCH_ALLOW_REMOTE_OVERRIDES=

# Exact 1 enables signed-out, read-only justinfan IRC; signed-in credentials win.
COMICTOONS_TWITCH_ANON=
# COMICTOONS_TWITCH_IRC_URL above is optional irc(s)://loopback:port, never a remote override.
